// Talkie library (ArminJo fork) - NATO phonetic alphabet speller
// with pitch, speech speed, and word pause control
//
// Based on: https://github.com/ArminJo/Talkie
//
// Spells out a predefined string using the NATO phonetic alphabet,
// with selectable pitch, speech speed, and word pause settings.
//
// NOTE: The vocabulary bank has no "YANKEE" entry, so "YELLOW" is used
// in its place for the letter Y.
//
// Input string may be upper or lower case — handled via toupper().
/
// IMPORTANT: ENABLE_PITCH must be defined BEFORE #include <Talkie.h>
// to activate the pitch-controlled say() overload.

#define ENABLE_PITCH
#include <Talkie.h>

Talkie voice;


// ============================================================
// PITCH PRESETS
// ============================================================
//
// Lower sample rate value  -> faster playback -> HIGHER pitch
// Higher sample rate value -> slower playback -> LOWER pitch
//
// These affect both pitch and playback speed because Talkie
// changes the playback sample rate.
//
// ============================================================

const unsigned int PITCH_NORMAL     = ORIGINAL_SAMPLE_RATE;
const unsigned int PITCH_HIGH       = ORIGINAL_SAMPLE_RATE - 2000;
const unsigned int PITCH_VERY_HIGH  = ORIGINAL_SAMPLE_RATE - 3500;
const unsigned int PITCH_LOW        = ORIGINAL_SAMPLE_RATE + 2000;
const unsigned int PITCH_VERY_LOW   = ORIGINAL_SAMPLE_RATE + 4000;


// Select which pitch preset to use
unsigned int currentPitch = PITCH_NORMAL;


// ============================================================
// SPEECH SPEED PRESETS
// ============================================================
//
// 1.00 = normal
// 1.25 = 25% faster
// 1.50 = 50% faster
// 2.00 = twice as fast
//
// 0.75 = 25% slower
// 0.50 = half speed
//
// The speed value changes the playback rate relative to the
// selected pitch setting.
//
// ============================================================

const float SPEED_VERY_SLOW = 0.50;
const float SPEED_SLOW      = 0.75;
const float SPEED_NORMAL    = 1.00;
const float SPEED_FAST      = 1.25;
const float SPEED_VERY_FAST = 1.50;
const float SPEED_DOUBLE    = 2.00;


// Select which speech speed to use
float speechSpeed = SPEED_NORMAL;


// ============================================================
// WORD PAUSE PRESETS
// ============================================================
//
// These control the pause between words.
//
// Value is in milliseconds.
//
// ============================================================

const unsigned int PAUSE_SHORT  = 200;
const unsigned int PAUSE_NORMAL = 400;
const unsigned int PAUSE_LONG   = 600;
const unsigned int PAUSE_VERY_LONG = 800;


// Select which word pause to use
unsigned int wordPause = PAUSE_NORMAL;


// ============================================================
// CALCULATE FINAL TALKIE SAMPLE RATE
// ============================================================
//
// Talkie's pitch control works by changing the playback
// sample rate.
//
// speechSpeed then modifies that rate:
//
// speed > 1.0  -> faster
// speed < 1.0  -> slower
//
// ============================================================

unsigned int getSpeechRate() {

  float rate = (float)currentPitch / speechSpeed;

  // Prevent invalid values
  if (rate < 1000.0) {
    rate = 1000.0;
  }

  if (rate > 65535.0) {
    rate = 65535.0;
  }

  return (unsigned int)rate;
}


