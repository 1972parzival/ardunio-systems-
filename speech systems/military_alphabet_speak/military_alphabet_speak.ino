// ============================================================
// SPEAK ONE LETTER PHONETICALLY
// ============================================================

void speakLetter(char c) {

  c = toupper(c);

  switch (c) {

    case 'A': voice.say(spALPHA,    getSpeechRate()); break;
    case 'B': voice.say(spBRAVO,    getSpeechRate()); break;
    case 'C': voice.say(spCHARLIE,  getSpeechRate()); break;
    case 'D': voice.say(spDELTA,    getSpeechRate()); break;
    case 'E': voice.say(spECHO,     getSpeechRate()); break;
    case 'F': voice.say(spFOXTROT,  getSpeechRate()); break;
    case 'G': voice.say(spGOLF,     getSpeechRate()); break;
    case 'H': voice.say(spHOTEL,    getSpeechRate()); break;
    case 'I': voice.say(spINDIA,    getSpeechRate()); break;
    case 'J': voice.say(spJULIET,   getSpeechRate()); break;
    case 'K': voice.say(spKILO,     getSpeechRate()); break;
    case 'L': voice.say(spLIMA,     getSpeechRate()); break;
    case 'M': voice.say(spMIKE,     getSpeechRate()); break;
    case 'N': voice.say(spNOVEMBER, getSpeechRate()); break;
    case 'O': voice.say(spOSCAR,    getSpeechRate()); break;
    case 'P': voice.say(spPAPA,     getSpeechRate()); break;
    case 'Q': voice.say(spQUEBEC,   getSpeechRate()); break;
    case 'R': voice.say(spROMEO,    getSpeechRate()); break;
    case 'S': voice.say(spSIERRA,   getSpeechRate()); break;
    case 'T': voice.say(spTANGO,    getSpeechRate()); break;
    case 'U': voice.say(spUNIFORM,  getSpeechRate()); break;
    case 'V': voice.say(spVICTOR,   getSpeechRate()); break;
    case 'W': voice.say(spWHISKEY,  getSpeechRate()); break;
    case 'X': voice.say(spXRAY,     getSpeechRate()); break;
    case 'Y': voice.say(spYELLOW,   getSpeechRate()); break;
    case 'Z': voice.say(spZULU,     getSpeechRate()); break;

    case ' ':
      delay(wordPause);
      break;

    default:
      break;
  }
}


